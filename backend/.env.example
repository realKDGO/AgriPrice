# AgriPrice — Backend Environment Variables Configuration
# Copy this file to .env and configure the values for your local environment.

# Server Port
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# PostgreSQL Connection Strings (Supabase)
# Connect to PostgreSQL via connection pooler (transaction-mode)
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"

# Connect to PostgreSQL directly for migrations (session-mode)
DIRECT_URL="postgresql://username:password@host:port/database"

# JWT Configuration
# Must be a secure random string of at least 32 characters
JWT_SECRET="your_jwt_secret_minimum_32_characters_long_here"
